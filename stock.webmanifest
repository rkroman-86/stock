{
  "name": "Gestion de stock",
  "short_name": "Stock",
  "description": "Gestion de stock : produits, codes-barres, entrées et sorties, synchronisation Google Drive.",
  "lang": "fr",
  "start_url": "./index.html",
  "scope": "./index.html",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f4f1",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/stock/",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
